# Placeholder-only staging configuration. Copy locally to an ignored .env.local.
# Replace every value in the hosting dashboard only after staging authorization.
# Never commit real allowlist email addresses, tokens or provider credentials.
CF_ACCESS_ISSUER=https://replace-with-your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-your-application-audience
QUILLORA_ALLOWED_EMAILS=pilot-owner@example.invalid
QUILLORA_PUBLIC_ORIGIN=https://staging.example.invalid

# Optional local development only: set QUILLORA_ACCESS_MODE=local in your shell.
# This setting cannot bypass production verification. Do not set it on a host.
